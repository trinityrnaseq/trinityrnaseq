
OS := $(shell uname)

CXX = g++
CC = gcc
COLLECTL_CODE="collectl-4.1.0"
PARAFLY_CODE="ParaFly"
TRIMMOMATIC_CODE=Trimmomatic-0.40

# ParaFly OpenMP flags.
#
# A bare -fopenmp is rejected by Apple clang ("unsupported option '-fopenmp'"),
# which needs -Xpreprocessor -fopenmp to compile and -lomp to link, plus the
# include/lib paths of a separately installed libomp (e.g. Homebrew's).
#
# ParaFly's configure already calls AC_OPENMP, but it was generated by Autoconf
# 2.71, whose candidate list has no Apple clang form, so it would find no
# OpenMP and ParaFly's unconditional #include <omp.h> would fail. Hence the
# flags are supplied explicitly here. Any CPPFLAGS/LDFLAGS set by the user are
# appended so a libomp in a non-standard prefix is still found.
ifeq ($(OS),Darwin)
  # Homebrew's libomp is keg-only. Use it only if it is installed, and never inside a
  # conda build (Bioconda's macOS builds use conda's llvm-openmp via CPPFLAGS/LDFLAGS).
  ifndef CONDA_BUILD
    LIBOMP_PREFIX := $(shell brew --prefix libomp 2>/dev/null)
  endif
  ifneq ($(and $(strip $(LIBOMP_PREFIX)),$(wildcard $(LIBOMP_PREFIX)/include/omp.h)),)
    LIBOMP_CPPFLAGS := -I$(LIBOMP_PREFIX)/include
    LIBOMP_LDFLAGS := -L$(LIBOMP_PREFIX)/lib
  endif
  PARAFLY_OMP_CFLAGS = -Xpreprocessor -fopenmp
  PARAFLY_CPPFLAGS = $(LIBOMP_CPPFLAGS) $(CPPFLAGS)
  PARAFLY_LDFLAGS = $(LIBOMP_LDFLAGS) $(LDFLAGS) -lomp
else
  PARAFLY_OMP_CFLAGS = -fopenmp
  PARAFLY_CPPFLAGS = $(CPPFLAGS)
  PARAFLY_LDFLAGS = $(LDFLAGS)
endif



trinity_essentials: seqtk_target parafly_target trimmomatic_target bamsifter_target

no_bamsifter: seqtk_target parafly_target trimmomatic_target


trimmomatic_target:
	ln -sf ${TRIMMOMATIC_CODE} Trimmomatic


seqtk_target:
	cd seqtk-trinity && $(MAKE) CXX=$(CXX) CC=$(CC)
	mv seqtk-trinity/seqtk-trinity ./BIN/.

parafly_target:
	cd ${PARAFLY_CODE} && sh ./configure --prefix=`pwd` CXX=$(CXX) CC=$(CC) CFLAGS="$(PARAFLY_OMP_CFLAGS)" CXXFLAGS="$(PARAFLY_OMP_CFLAGS)" CPPFLAGS="$(PARAFLY_CPPFLAGS)" LDFLAGS="$(PARAFLY_LDFLAGS)" && $(MAKE) install && \
	cp bin/ParaFly ../BIN/


bamsifter_target:
	cd bamsifter && make

##################################
### Needed for downstream analyses
##################################

plugins: slclust_target collectl_target
	@echo "\n\n** Done building plugins **\n\n"


slclust_target:
	cd slclust && $(MAKE) CXX=$(CXX) CC=$(CC) install

collectl_target:
	cd COLLECTL && tar xvf ${COLLECTL_CODE}.src.tar.gz && ln -sf ${COLLECTL_CODE} collectl

clean:
	cd seqtk-trinity && $(MAKE) clean
	cd scaffold_iworm_contigs && $(MAKE) clean
	-cd ${PARAFLY_CODE} && $(MAKE) clean
	rm -f ./Trimmomatic # rm symlink
	cd slclust && $(MAKE) clean
	cd COLLECTL && rm -rf ${COLLECTL_CODE} && rm -f collectl
	cd bamsifter && $(MAKE) clean
	rm -f ./htslib.ok
	@echo "\n\n** Done cleaning plugins area **"


###################################################################


